[Unit]
Description=Traffic Guard control bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/traffic-guard
EnvironmentFile=/etc/traffic-guard-control.env
ExecStart=/opt/traffic-guard/.venv/bin/traffic-guard --env-file /etc/traffic-guard-control.env control-bot
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
