[Unit]
Description=Traffic Guard Telegram notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/traffic-guard
EnvironmentFile=/etc/traffic-guard.env
ExecStart=/opt/traffic-guard/.venv/bin/traffic-guard daemon
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
